# --- Secrets / env ---
.env
.env.*
!.env.example
!.env.production.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- Spencer runtime data (must never be committed) ---
# Persistent DuckDB file: contains uploaded user data + accumulated test tables
backend/spencer.db
backend/spencer.db.wal
*.duckdb
# Uploaded files, one dir per session
backend/uploads/
# Persistent SQLite identity store (users + dataset ownership): holds real account
# rows (emails + bcrypt hashes) once anyone registers -- must never be committed.
backend/spencer_app.db
backend/spencer_app.db-wal
backend/spencer_app.db-shm

# --- Node / frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.local

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*

# --- Local dev tooling (portable Redis binaries, ~12MB — not source) ---
tools/

