# Project Spencer -- PRODUCTION environment template.
# Copy to `.env` on the deploy host (docker compose auto-loads `.env`):
#     cp .env.production.example .env   &&   nano .env
# `.env` is gitignored and must NEVER be committed. Fill every CHANGE_ME value.

# --- Site / TLS ---
# The public hostname. Caddy provisions + renews a Let's Encrypt certificate for
# it automatically (ports 80 + 443 must be open and DNS must point here). Leave
# blank (or ":80") to serve plain HTTP -- used for the local compose proof or when
# behind an external TLS terminator.
SITE_ADDRESS=app.example.com

# --- Auth (REQUIRED) ---
# HS256 signing secret. Generate once: `openssl rand -hex 32`. In production the
# backend REFUSES TO START if this is unset (tokens would otherwise be forgeable).
SPENCER_JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
SPENCER_JWT_EXPIRY_HOURS=168
# Ships CLOSED: the LLM key pool is global/paid until per-user quota lands, so open
# signup would let strangers spend your provider quota. See DEPLOY.md §6 to create
# the first account; flip to true only behind an invite flow or once quota exists.
SPENCER_ALLOW_REGISTRATION=false

# --- Postgres (identity / ownership store) ---
# Used to run the `db` service AND to build the backend's SPENCER_APP_DB_URL DSN.
# NOTE: the password is interpolated into that URL, so keep it URL-safe -- avoid
# @ : / ? # % (plain letters+digits, or `openssl rand -hex 24`, are safe).
POSTGRES_USER=spencer
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=spencer

# --- LLM providers (optional; supply whichever you use) ---
# Secrets -- keep them only here in the gitignored .env. Multiple comma-separated
# keys rotate on 429 (TASK-024). Leave all blank to run without the AI layer.
GEMINI_API_KEY=
GEMINI_API_KEYS=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=
SPENCER_LLM_MODEL=

# --- Sizing / lifecycle (optional; sensible defaults if omitted) ---
SPENCER_OWNED_SESSION_TTL_DAYS=30
SPENCER_MAX_UPLOAD_MB=100
