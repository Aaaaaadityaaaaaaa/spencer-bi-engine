# Project Spencer — environment template.
# Copy to .env and fill in real values. .env is gitignored and must NEVER be committed.

# --- LLM providers (Phase 6 AI layer) ---
# Only one is required; Spencer supports Claude or Gemini for text-to-SQL.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Quota-aware key pool (TASK-024): supply MULTIPLE comma-separated keys to rotate
# across them and fail over on a 429 (e.g. the Gemini free tier's 20 req/day/model).
# The singular vars above still work as a one-key pool; plural + singular are merged
# (deduped, order preserved). Keys are SECRETS: keep them only here in the gitignored
# .env -- they are never committed, never logged (only a masked "AIza...wxyz" form is),
# and never returned by any endpoint.
# GEMINI_API_KEYS=AIza...key1,AIza...key2,AIza...key3
# ANTHROPIC_API_KEYS=sk-ant-...key1,sk-ant-...key2
# Optional explicit model override (LiteLLM id, e.g. "anthropic/claude-sonnet-5"
# or "gemini/gemini-2.5-flash"). If unset, the provider is chosen by whichever
# key above is present, using a sensible default model.
# SPENCER_LLM_MODEL=
# Thinking-model budget for the (short, structured) AI calls. Modern "thinking"
# models otherwise spend many seconds reasoning before a tiny answer; every task
# here is narrow (suggest questions, one SELECT, pick a chart), so we cap it.
# One of: minimal | low | medium | high, or "default"/blank to send nothing and
# use the provider's own budget. Defaults to "low" (fast, still coherent).
# SPENCER_LLM_REASONING_EFFORT=low

# --- Redis (ADR-011) ---
# Defaults to localhost:6379, which matches Memurai, a native redis-server,
# and the docker-compose service. If unreachable, redis_manager falls back to
# fakeredis and logs a warning — check redis_manager.backend to see which is live.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- CORS ---
# Comma-separated list of allowed frontend origins. Wildcard "*" is invalid
# when credentials are allowed, so this must be explicit.
SPENCER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth & multi-tenancy (TASK-027) ---
# JWT signing secret (HS256). REQUIRED in any real deployment: set to a long
# random value, e.g. `openssl rand -hex 32`. If unset, an INSECURE built-in dev
# key is used (it ships in the repo, so tokens signed with it are forgeable) and
# a warning is logged at startup. Never deploy without setting this.
SPENCER_JWT_SECRET=
# Access-token lifetime in hours (default 168 = 7 days).
SPENCER_JWT_EXPIRY_HOURS=168
# Identity/ownership store URL (SQLAlchemy). SQLite by default (zero-infra dev);
# production sets a Postgres URL. Separate from the analytical DuckDB + Redis.
SPENCER_APP_DB_URL=sqlite:///spencer_app.db
# SPENCER_APP_DB_URL=postgresql+psycopg://spencer:CHANGE_ME@db:5432/spencer
# Open self-serve registration. Set false to lock a deployment to already-
# provisioned accounts (POST /auth/register then returns 403).
SPENCER_ALLOW_REGISTRATION=true
# A logged-in user's dataset survives this many days of inactivity before the
# sweeper may reclaim it (longer than the anonymous SESSION_TTL_HOURS below).
SPENCER_OWNED_SESSION_TTL_DAYS=30
# Deployment environment (TASK-028). Leave "development" locally. Set to
# "production" on a real deploy: the backend then REFUSES TO START unless
# SPENCER_JWT_SECRET is set (guards against shipping the forgeable dev key) and
# warns if the app DB is still SQLite. The production compose stack sets this for you.
SPENCER_ENV=development

# --- Deployment / storage lifecycle (TASK-013, single-VM disposable) ---
# Upload guardrails. MAX_UPLOAD_MB is enforced in three layers: an nginx
# `client_max_body_size` in front (the true pre-server gate -- set it to match),
# a Content-Length middleware early-reject, and a streaming byte-count backstop.
# ALLOWED_EXT is a comma-separated extension allowlist (no dots, case-insensitive).
# Default spans every ingestion reader: csv,tsv (read_csv_auto), parquet, json, xlsx.
SPENCER_MAX_UPLOAD_MB=100
SPENCER_UPLOAD_ALLOWED_EXT=csv,tsv,parquet,json,xlsx

# Session liveness / cleanup sweep. A `session:{uuid}` marker with this sliding
# TTL defines the session lifetime; a background sweep every INTERVAL minutes
# reclaims dead sessions' upload dirs + DuckDB tables + Redis keys. GRACE_MIN
# protects an in-flight upload dir from being reaped mid-upload.
# NOTE (disposable model): the portable redis-server does not survive reboot;
# when Redis is wiped, all liveness markers vanish and the next sweep reclaims
# every upload dir + its tables. For disposable data this is intended.
SPENCER_SESSION_TTL_HOURS=24
SPENCER_SWEEP_INTERVAL_MIN=30
SPENCER_SWEEP_GRACE_MIN=15

# DuckDB runtime hardening applied at startup (PRAGMA). memory_limit accepts
# "4GB", "512MiB", "80%", etc. TEMP_DIR (if set) is where DuckDB spills to disk
# when a query exceeds memory; leave unset for the DuckDB default.
SPENCER_DUCKDB_MEMORY_LIMIT=4GB
# SPENCER_DUCKDB_TEMP_DIR=

# --- LLM key-pool tuning (TASK-024) ---
# Proactive per-key daily soft cap: skip a key once it has served this many successful
# requests in a UTC day, before even trying it. 0 = off (rotate reactively on 429 only).
# Set to 20 to mirror the Gemini free tier (20 requests/day/model).
# SPENCER_LLM_DAILY_LIMIT_PER_KEY=0
# Reactive cooldown (seconds) for a per-minute 429 that carries no retryDelay hint.
# SPENCER_LLM_KEY_COOLDOWN_SECONDS=60
# Reactive cooldown (seconds) for a per-DAY quota exhaustion; ~6h self-heals across
# the provider's daily reset without timezone math.
# SPENCER_LLM_DAILY_COOLDOWN_SECONDS=21600
